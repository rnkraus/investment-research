{
  "name": "@investment-research/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "contracts:check": "openapi-typescript src/lib/api/generated/openapi.json --output src/lib/api/generated/schema.d.ts --immutable --check",
    "contracts:generate": "openapi-typescript src/lib/api/generated/openapi.json --output src/lib/api/generated/schema.d.ts --immutable",
    "dev": "next dev --hostname 127.0.0.1",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "start": "next start --hostname 127.0.0.1",
    "test": "pnpm contracts:check && node --test",
    "test:browser": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
