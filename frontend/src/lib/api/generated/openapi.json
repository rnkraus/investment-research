{
  "components": {
    "schemas": {
      "AnswerCitationEvent": {
        "additionalProperties": false,
        "description": "One validated relationship between a statement and evidence.",
        "properties": {
          "display_order": {
            "minimum": 0,
            "title": "Display Order",
            "type": "integer"
          },
          "event": {
            "const": "answer.citation",
            "default": "answer.citation",
            "title": "Event",
            "type": "string"
          },
          "evidence_span_id": {
            "format": "uuid",
            "title": "Evidence Span Id",
            "type": "string"
          },
          "relationship": {
            "$ref": "#/components/schemas/EvidenceRelationship"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "statement_id": {
            "format": "uuid",
            "title": "Statement Id",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "statement_id",
          "evidence_span_id",
          "relationship",
          "display_order"
        ],
        "title": "AnswerCitationEvent",
        "type": "object"
      },
      "AnswerCompletedEvent": {
        "additionalProperties": false,
        "description": "Terminal event for a validated answer.",
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CoverageStatus"
          },
          "event": {
            "const": "answer.completed",
            "default": "answer.completed",
            "title": "Event",
            "type": "string"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "coverage"
        ],
        "title": "AnswerCompletedEvent",
        "type": "object"
      },
      "AnswerInsufficientEvent": {
        "additionalProperties": false,
        "description": "Terminal event when eligible archive evidence is insufficient.",
        "properties": {
          "coverage": {
            "const": "INSUFFICIENT",
            "default": "INSUFFICIENT",
            "title": "Coverage",
            "type": "string"
          },
          "event": {
            "const": "answer.insufficient",
            "default": "answer.insufficient",
            "title": "Event",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "message"
        ],
        "title": "AnswerInsufficientEvent",
        "type": "object"
      },
      "AnswerStatementEvent": {
        "additionalProperties": false,
        "description": "One validated answer statement safe for rendering.",
        "properties": {
          "event": {
            "const": "answer.statement",
            "default": "answer.statement",
            "title": "Event",
            "type": "string"
          },
          "order": {
            "minimum": 0,
            "title": "Order",
            "type": "integer"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "statement_id": {
            "format": "uuid",
            "title": "Statement Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "statement_id",
          "order",
          "text"
        ],
        "title": "AnswerStatementEvent",
        "type": "object"
      },
      "Body_capture_document_api_v1_documents_post": {
        "properties": {
          "available_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available At"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "English PDF original to preserve and process",
            "title": "File",
            "type": "string"
          },
          "language": {
            "default": "en",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "title": "Language",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "file",
          "title"
        ],
        "title": "Body_capture_document_api_v1_documents_post",
        "type": "object"
      },
      "CoverageStatus": {
        "description": "Evidence coverage reported after validation.",
        "enum": [
          "COMPLETE",
          "PARTIAL",
          "INSUFFICIENT",
          "CONFLICTING"
        ],
        "title": "CoverageStatus",
        "type": "string"
      },
      "DocumentAccepted": {
        "additionalProperties": false,
        "description": "Identifiers returned after immutable capture has been accepted.",
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "processing_run_id": {
            "format": "uuid",
            "title": "Processing Run Id",
            "type": "string"
          },
          "processing_status_url": {
            "title": "Processing Status Url",
            "type": "string"
          },
          "state": {
            "const": "CAPTURED",
            "default": "CAPTURED",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "document_version_id",
          "processing_run_id",
          "processing_status_url"
        ],
        "title": "DocumentAccepted",
        "type": "object"
      },
      "DocumentMetadataInput": {
        "additionalProperties": false,
        "description": "Validated metadata fields submitted alongside an uploaded document.",
        "properties": {
          "available_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Available At"
          },
          "language": {
            "default": "en",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "title": "Language",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Published At"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "DocumentMetadataInput",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable public error categories without internal details.",
        "enum": [
          "INVALID_REQUEST",
          "NOT_FOUND",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "PROCESSING_FAILED",
          "EVIDENCE_VALIDATION_FAILED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Safe machine-readable error detail.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Envelope used by non-streaming API failures.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidenceRelationship": {
        "description": "How a source span relates to an answer statement.",
        "enum": [
          "SUPPORTS",
          "CONFLICTS"
        ],
        "title": "EvidenceRelationship",
        "type": "string"
      },
      "EvidenceSpanResult": {
        "additionalProperties": false,
        "description": "Exact source location returned for an authorized citation.",
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "end_character": {
            "exclusiveMinimum": 0,
            "title": "End Character",
            "type": "integer"
          },
          "evidence_span_id": {
            "format": "uuid",
            "title": "Evidence Span Id",
            "type": "string"
          },
          "exact_text": {
            "minLength": 1,
            "title": "Exact Text",
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "start_character": {
            "minimum": 0,
            "title": "Start Character",
            "type": "integer"
          },
          "text_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Text Sha256",
            "type": "string"
          },
          "viewer_url": {
            "title": "Viewer Url",
            "type": "string"
          }
        },
        "required": [
          "evidence_span_id",
          "document_id",
          "document_version_id",
          "page",
          "start_character",
          "end_character",
          "exact_text",
          "text_sha256",
          "viewer_url"
        ],
        "title": "EvidenceSpanResult",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Public health response without dependency or credential details.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProcessingRunResult": {
        "additionalProperties": false,
        "description": "Safe processing status visible to the owning workspace.",
        "properties": {
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "error_summary": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "processing_run_id": {
            "format": "uuid",
            "title": "Processing Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ProcessingState"
          }
        },
        "required": [
          "processing_run_id",
          "document_version_id",
          "state"
        ],
        "title": "ProcessingRunResult",
        "type": "object"
      },
      "ProcessingState": {
        "description": "States implemented by the M0.0 lexical processing lifecycle.",
        "enum": [
          "CAPTURED",
          "PARSING",
          "LEXICAL_READY",
          "FAILED"
        ],
        "title": "ProcessingState",
        "type": "string"
      },
      "ResearchFailedEvent": {
        "additionalProperties": false,
        "description": "Terminal event for a safely reported research failure.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "event": {
            "const": "research.failed",
            "default": "research.failed",
            "title": "Event",
            "type": "string"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "retriable": {
            "title": "Retriable",
            "type": "boolean"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "error",
          "retriable"
        ],
        "title": "ResearchFailedEvent",
        "type": "object"
      },
      "ResearchProgressEvent": {
        "additionalProperties": false,
        "description": "Progress emitted before validated answer content exists.",
        "properties": {
          "event": {
            "const": "research.progress",
            "default": "research.progress",
            "title": "Event",
            "type": "string"
          },
          "research_request_id": {
            "format": "uuid",
            "title": "Research Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "stage": {
            "enum": [
              "RETRIEVING",
              "GENERATING",
              "VALIDATING"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "research_request_id",
          "stage"
        ],
        "title": "ResearchProgressEvent",
        "type": "object"
      },
      "ResearchRequestContext": {
        "additionalProperties": false,
        "description": "Explicit archive filters supplied with a research question.",
        "properties": {
          "cutoff_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cutoff At"
          },
          "document_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 100,
            "title": "Document Ids",
            "type": "array"
          },
          "temporal_mode": {
            "$ref": "#/components/schemas/TemporalMode",
            "default": "CURRENT"
          }
        },
        "title": "ResearchRequestContext",
        "type": "object"
      },
      "ResearchRequestInput": {
        "additionalProperties": false,
        "description": "Question and explicit context accepted by the research endpoint.",
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ResearchRequestContext"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "ResearchRequestInput",
        "type": "object"
      },
      "ResearchStreamEvent": {
        "discriminator": {
          "mapping": {
            "answer.citation": "#/components/schemas/AnswerCitationEvent",
            "answer.completed": "#/components/schemas/AnswerCompletedEvent",
            "answer.insufficient": "#/components/schemas/AnswerInsufficientEvent",
            "answer.statement": "#/components/schemas/AnswerStatementEvent",
            "research.failed": "#/components/schemas/ResearchFailedEvent",
            "research.progress": "#/components/schemas/ResearchProgressEvent"
          },
          "propertyName": "event"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResearchProgressEvent"
          },
          {
            "$ref": "#/components/schemas/AnswerStatementEvent"
          },
          {
            "$ref": "#/components/schemas/AnswerCitationEvent"
          },
          {
            "$ref": "#/components/schemas/AnswerCompletedEvent"
          },
          {
            "$ref": "#/components/schemas/AnswerInsufficientEvent"
          },
          {
            "$ref": "#/components/schemas/ResearchFailedEvent"
          }
        ]
      },
      "TemporalMode": {
        "description": "Eligibility clocks available to a research request.",
        "enum": [
          "CURRENT",
          "PUBLIC_KNOWLEDGE",
          "PERSONAL_ARCHIVE"
        ],
        "title": "TemporalMode",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Local-only M0.0 API for evidence-grounded investment research.",
    "title": "Investment Research Archive",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/documents": {
      "post": {
        "description": "Accept one bounded PDF and return its canonical capture identifiers.",
        "operationId": "capture_document_api_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_capture_document_api_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Capture Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/documents/{document_id}/versions/{version_id}/original": {
      "get": {
        "description": "Stream one verified current original without disclosing foreign records.",
        "operationId": "open_original_api_v1_documents__document_id__versions__version_id__original_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Verified immutable PDF original"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Open Original",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/processing-runs/{processing_run_id}": {
      "get": {
        "description": "Return safe status for one run without disclosing inaccessible identifiers.",
        "operationId": "get_processing_run_api_v1_processing_runs__processing_run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "processing_run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Processing Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingRunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get Processing Run",
        "tags": [
          "processing"
        ]
      }
    },
    "/api/v1/research-requests": {
      "post": {
        "description": "Execute one bounded request and stream only its validated terminal output.",
        "operationId": "answer_research_request_api_v1_research_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequestInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchStreamEvent"
                }
              }
            },
            "description": "Validated research answer events"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Answer Research Request",
        "tags": [
          "research"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report API process liveness.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
