# Local Docker Compose and backend configuration. Copy this file to .env for development.
INVESTMENT_RESEARCH_ENVIRONMENT=development
INVESTMENT_RESEARCH_RUNTIME_LOCATION=host
INVESTMENT_RESEARCH_API_HOST=127.0.0.1
INVESTMENT_RESEARCH_API_PORT=8000
INVESTMENT_RESEARCH_LOG_LEVEL=INFO

# PostgreSQL bootstrap values; POSTGRES_PORT is used only by host tools and test overrides.
POSTGRES_DB=investment_research
POSTGRES_USER=investment_research
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
POSTGRES_PASSWORD_SECRET_FILE=.secrets/postgres_password

# Redis bootstrap values also provide the host-development broker fallback.
REDIS_PASSWORD=replace-with-a-different-local-only-password
REDIS_PORT=6379
REDIS_PASSWORD_SECRET_FILE=.secrets/redis_password

# Optional host-run processes use the private local adapter by default.
# Compose overrides API and worker to use its internal SeaweedFS S3 endpoint.
INVESTMENT_RESEARCH_OBJECT_STORAGE_PROVIDER=local
INVESTMENT_RESEARCH_OBJECT_STORAGE_ROOT=output/object-storage
INVESTMENT_RESEARCH_S3_REGION_NAME=us-east-1
INVESTMENT_RESEARCH_S3_BUCKET=investment-research-local
SEAWEEDFS_ADMIN_ACCESS_KEY_SECRET_FILE=.secrets/seaweedfs_admin_access_key
SEAWEEDFS_ADMIN_SECRET_ACCESS_KEY_SECRET_FILE=.secrets/seaweedfs_admin_secret_access_key
INVESTMENT_RESEARCH_S3_ACCESS_KEY_ID_SECRET_FILE=.secrets/seaweedfs_application_access_key
INVESTMENT_RESEARCH_S3_SECRET_ACCESS_KEY_SECRET_FILE=.secrets/seaweedfs_application_secret_access_key

# Host processes use loopback; M0 Compose injects http://parser:8100 into the worker.
INVESTMENT_RESEARCH_PARSER_ENDPOINT_URL=http://127.0.0.1:8100
INVESTMENT_RESEARCH_PARSER_HOST=127.0.0.1
INVESTMENT_RESEARCH_PARSER_PORT=8100

# 25 MiB, shared by API upload and the worker-to-parser request boundary.
INVESTMENT_RESEARCH_MAX_UPLOAD_BYTES=26214400

# Bounded text extraction shared by the worker request and isolated parser ceiling.
INVESTMENT_RESEARCH_MAX_PDF_PAGES=250
INVESTMENT_RESEARCH_MAX_EXTRACTED_CHARACTERS=2000000

# Maximum time for one private worker-to-parser request.
INVESTMENT_RESEARCH_PROCESSING_TIMEOUT_SECONDS=30
