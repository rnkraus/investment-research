# Internal SeaweedFS configuration. Copy this file to storage.env for local Compose use.
INVESTMENT_RESEARCH_S3_REGION_NAME=us-east-1
INVESTMENT_RESEARCH_S3_BUCKET=investment-research-originals

# Least-privilege credentials used by API and worker after they join Compose in M0 Step 4.
INVESTMENT_RESEARCH_S3_ACCESS_KEY_ID=replace-with-app-access-key
INVESTMENT_RESEARCH_S3_SECRET_ACCESS_KEY=replace-with-app-secret-key

# Administrative credentials used only by the S3 gateway and one-shot bucket bootstrap.
SEAWEEDFS_ADMIN_ACCESS_KEY=replace-with-admin-access-key
SEAWEEDFS_ADMIN_SECRET_ACCESS_KEY=replace-with-admin-secret-key
